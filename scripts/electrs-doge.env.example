# electrs-doge launch overrides (optional; copy to User env or set before electrs-doge-launch)

# Dogecoin Core datadir (blocks, chainstate, dogecoin.conf, .cookie)
DOGECOIN_DATA_DIR=F:\DogecoinData

# electrs RocksDB index — kept on F: next to Core (NOT inside repo)
ELECTRS_DB_DIR=F:\DogecoinData\electrs

# Repo path (install script sets ELECTRS_REPO)
#ELECTRS_REPO=C:\Users\jheav\Desktop\dogeco\electrs-doge

ELECTRS_NETWORK=mainnet
ELECTRS_DAEMON_RPC_ADDR=127.0.0.1:22555
ELECTRS_ELECTRUM_ADDR=127.0.0.1:50001
# NOT :3000 — that is command.dog/api
ELECTRS_HTTP_ADDR=127.0.0.1:3003
#ELECTRS_CORS=*

# Read from dogecoin.conf when unset
#DOGE_RPC_USERNAME=dogewizard
#DOGE_RPC_PASSWORD=typejawn

# Default: light index (~half disk). Set ELECTRS_FULL_MODE=1 or launch with -FullMode for full index.
ELECTRS_LIGHTMODE=1
#ELECTRS_FULL_MODE=1
